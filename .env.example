# Settings for the local Docker stack (docker-compose.yml reads this file).
#
# Copy to .env and fill in real values. .env is gitignored; this file is not, so
# it must never contain a real secret.
#
#   cp .env.example .env
#
# Application settings live in apps/api/.env — see apps/api/.env.example.

POSTGRES_USER=goalify
# Also embedded in a connection URL by docker-compose, so keep it to URL-safe
# characters: an unescaped @ or / here would produce a URL that parses as something
# else entirely, and the error you get back would be about the wrong thing.
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=goalify
# 5432 is the Postgres default. This stack uses 5433 on the host because another
# Postgres may already hold 5432; the container still listens on 5432 internally.
POSTGRES_PORT=5433

# --- Centrifugo (realtime) ---------------------------------------------------
# Both secrets below are shared with the API, which signs connection tokens with
# the first and authenticates its publish calls with the second. Generate real
# ones — they are the whole of the access control:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
CENTRIFUGO_TOKEN_HMAC_SECRET=replace-me
CENTRIFUGO_API_KEY=replace-me
# Which sites may open a WebSocket. Space-separated, and never "*": Centrifugo
# skips the Origin check entirely when this is empty, so the compose file treats
# an unset or empty value as a fatal error rather than a default.
#
# The first two are the Vite dev server; the third is the containerised app on
# APP_PORT below, which reaches Centrifugo through nginx on its own origin.
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:5173 http://localhost:5174 http://localhost:8080
CENTRIFUGO_PORT=8000

# --- Application containers --------------------------------------------------
# Only read by `docker compose --profile app`, which builds and runs the API and
# web images. Plain `docker compose up -d` starts the infrastructure alone and
# ignores everything in this section.
#
# The API's own settings — DATABASE_URL, the AI credentials — are not repeated here.
# The api service reads apps/api/.env directly so that a real key lives in one
# place; compose overrides only the handful of values in it that describe a
# developer's machine rather than the container network.
APP_PORT=8080
# 127.0.0.1 keeps the app off the local network. Set to 0.0.0.0 only when serving
# other machines is the actual intention.
APP_BIND=127.0.0.1
# What the browser sees, so it must match APP_BIND/APP_PORT above. The API uses it
# as its CORS origin, and it must also appear in CENTRIFUGO_ALLOWED_ORIGINS.
APP_ORIGIN=http://localhost:8080
# What the API tells browsers to connect to for realtime. Same origin as the app,
# because nginx proxies /connection/websocket through to Centrifugo. Behind TLS
# this becomes wss://your-domain/connection/websocket.
CENTRIFUGO_WS_URL=ws://localhost:8080/connection/websocket
# Comma-separated existing account emails permitted to view admin registration IP counts.
ADMIN_EMAILS=
