DATABASE_URL="postgresql://goalify:replace-me@localhost:5433/goalify?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# --- Behind a proxy? --------------------------------------------------------
# Off unless set, which is the safe default: with it on the server takes the
# client's address from a header the client can write, so switching it on while
# the port is reachable directly hands anyone a free identity spoof — and the
# per-address rate limits on sign-in and sign-up are keyed on that address.
#
# Set it to true only when something in front overwrites X-Forwarded-For and
# nothing else can reach this port; docker-compose does exactly that for the
# containerised deployment. A list of trusted proxy addresses or CIDR ranges
# works too. A bare hop count is deliberately refused — see lib/config-audit.ts.
# TRUST_PROXY=true

# --- AI (Phase 2) -----------------------------------------------------------
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_GOAL_COPILOT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=

# --- Background jobs (Phase 2.5) --------------------------------------------
# pg-boss runs in the DATABASE_URL above, in its own `pgboss` schema. Set to
# false on any process that should serve requests without also being the one
# that sends the scheduled daily notifications.
JOBS_ENABLED=true

# --- Realtime (Phase 2.5) ---------------------------------------------------
# Both values must match the ones docker-compose passes to Centrifugo, in the
# root .env — the API signs connection tokens with the secret Centrifugo
# verifies, and authenticates its publish calls with the API key.
#
# Leave all of this unset and the API still serves every endpoint; realtime just
# reports itself unavailable and the client falls back to fetching.
CENTRIFUGO_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
# What the browser is told to connect to. Optional only while CENTRIFUGO_URL is
# loopback, where it is derived; set it explicitly anywhere else, because the
# address the API uses to reach Centrifugo inside a container network is not one
# a browser can resolve.
# CENTRIFUGO_WS_URL=wss://goalify.app/connection/websocket
