// Goalify — Phase 1 domain model.
//
// Design notes:
//  * Status-like fields are Strings validated at the application boundary (see
//    src/domain/enums.ts) rather than native enums, and structured config is stored
//    as a JSON-encoded String. Both choices date from SQLite, which supported
//    neither; they are kept on PostgreSQL because the validation already lives in
//    one place and because changing a column's type is a data migration, not a
//    rename. Converting them is a deliberate future change, not a side effect of
//    changing database.
//  * A "challenge" is NOT a separate entity. A Goal with >1 GoalParticipant *is* a
//    challenge. Private goal = 1 participant. Public challenge = many.
//  * TaskDefinition (the recurring rule) is separate from TaskOccurrence (one dated
//    instance, per participant). Occurrences are the single source of truth for
//    progress, streaks and leaderboards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  registrationIp String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              Profile?
  ownedGoals           Goal[]                @relation("GoalOwner")
  participations       GoalParticipant[]
  sentFriendships      Friendship[]          @relation("FriendshipRequester")
  friendshipsA         Friendship[]          @relation("FriendshipUserA")
  friendshipsB         Friendship[]          @relation("FriendshipUserB")
  sentInvitations      GoalInvitation[]      @relation("InvitationInviter")
  receivedInvitations  GoalInvitation[]      @relation("InvitationInvitee")
  notifications        Notification[]
  achievements         UserAchievement[]
  rewards              RewardTransaction[]
  sessions             Session[]
  resetTokens          PasswordResetToken[]
  copilotSessions      CopilotSession[]
  goalDrafts           GoalDraft[]
  preferences          UserPreference[]
  recommendationEvents RecommendationEvent[]
  capabilityExecutions CapabilityExecution[]
  @@index([registrationIp])
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  avatarEmoji String @default("🐱")
  bio         String @default("")
  // IANA timezone, e.g. "Asia/Tbilisi". Used as the default for goals they create.
  timezone    String @default("UTC")

  totalCoins Int @default(0)
  level      Int @default(1)
  bestStreak Int @default(0)

  // Notification category toggles (Phase 1Q)
  notifyTaskReminders     Boolean @default(true)
  notifyFriendActivity    Boolean @default(true)
  notifyLeaderboardUpdate Boolean @default(true)
  notifyAchievements      Boolean @default(true)

  // The two scheduled daily notifications (Phase 2.5). Separate toggles because
  // they answer different questions: the morning one is a plan, the evening one is a
  // nudge, and wanting one is no reason to want the other.
  notifyMorningSummary Boolean @default(true)
  notifyEveningCheck   Boolean @default(true)

  /// HH:MM, read in this profile's own `timezone` — never in server time.
  morningTime String @default("08:00")
  eveningTime String @default("20:30")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Password resets are deliberately NOT sessions. A reset token must not be usable
// as a login by itself, must expire quickly, and must work exactly once.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------- goals

model Goal {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String @default("")
  category    String // GoalCategory

  visibility String // PRIVATE | PUBLIC
  status     String @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | ARCHIVED

  // Shareable join code. Anyone holding it may join, even a stranger and even
  // when the goal is PRIVATE — that is the point of handing the link out. It is
  // owner-generated, revocable and rotatable, so access can always be withdrawn.
  inviteCode        String?   @unique
  inviteCodeCreated DateTime?

  targetType  String // HABIT | QUANTITY | WEEKLY_TARGET | DEADLINE
  targetValue Int? // e.g. 10 books, 3x per week

  // Day boundaries for this goal are evaluated in this timezone (Phase 1L).
  // Defaults to the creator's timezone at creation time.
  timezone  String
  startDate String // YYYY-MM-DD, in the goal's timezone
  deadline  String? // YYYY-MM-DD, in the goal's timezone

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants         GoalParticipant[]
  tasks                TaskDefinition[]
  invitations          GoalInvitation[]
  rewards              RewardTransaction[]
  recommendationEvents RecommendationEvent[]

  @@index([visibility, status])
  @@index([ownerId])
}

model GoalParticipant {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   String @default("MEMBER") // OWNER | MEMBER
  status String @default("ACTIVE") // ACTIVE | LEFT

  // Day the participant joined, in the goal's timezone. Days before this are
  // excluded from their Average leaderboard score.
  joinedOn String // YYYY-MM-DD
  leftOn   String? // YYYY-MM-DD, exclusive upper bound once they leave

  currentStreak Int @default(0)
  bestStreak    Int @default(0)

  createdAt DateTime @default(now())

  occurrences TaskOccurrence[]
  feedback    TaskFeedback[]

  @@unique([goalId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- tasks

model TaskDefinition {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  title       String
  description String @default("")

  // ONCE | EVERY_DAY | SPECIFIC_WEEKDAYS | TIMES_PER_WEEK | EVERY_X_DAYS | MONTHLY | EVERY_X_MONTHS
  recurrenceType   String
  // JSON-encoded. Shape depends on recurrenceType:
  //   SPECIFIC_WEEKDAYS -> { "weekdays": [1,3,5] }   (0=Sun … 6=Sat)
  //   TIMES_PER_WEEK    -> { "timesPerWeek": 3 }
  //     optionally bounded by { "allowedWeekdays": [1,2,4], "excludedWeekdays": [3] }
  //   EVERY_X_DAYS      -> { "intervalDays": 2 }
  //   MONTHLY           -> { "dayOfMonth": 1 }, optionally with activeFrom,
  //                        activeUntil, and excludedMonths calendar bounds
  //   EVERY_X_MONTHS    -> { "intervalMonths": 2, "dayOfMonth": 1 }
  //   ONCE / EVERY_DAY  -> {}
  recurrenceConfig String @default("{}")

  reward Int @default(10) // coins granted on completion

  startDate    String // YYYY-MM-DD
  endDate      String? // YYYY-MM-DD
  reminderTime String? // HH:MM local to the goal's timezone

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  occurrences TaskOccurrence[]
  progression ProgressionPlan?
  feedback    TaskFeedback[]

  @@index([goalId])
}

model TaskOccurrence {
  id               String          @id @default(cuid())
  taskDefinitionId String
  taskDefinition   TaskDefinition  @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  participantId    String
  participant      GoalParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // The challenge day this occurrence belongs to, in the goal's timezone.
  dueDate String // YYYY-MM-DD
  status  String @default("PENDING") // PENDING | COMPLETED | MISSED | SKIPPED

  // Copied from the progression stage that was current when this day was
  // materialised, NOT read through the relation. Denormalised on purpose: it is
  // what makes history immutable. Advancing from "walk 15 min" to "walk 20 min"
  // must leave yesterday still saying 15, even though the stage row now says 20.
  // Null on tasks with no progression plan.
  progressionStageIndex Int?
  progressionTarget     Int?

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  reward   RewardTransaction?
  feedback TaskFeedback?

  @@unique([taskDefinitionId, participantId, dueDate])
  @@index([participantId, dueDate])
  @@index([dueDate, status])
}

/// How hard a task felt on one particular day, in the participant's own words:
/// too easy, just right, too hard.
///
/// Anchored on the occurrence rather than on (task, day) so the day is never
/// something a client gets to assert — it comes from the row being rated, which
/// the server has already checked belongs to the caller. The @unique on
/// taskOccurrenceId is what makes re-rating an update rather than a second vote.
///
/// taskDefinitionId, participantId and day are copied from the occurrence so the
/// "how has this task been feeling lately?" query needs no join. Cascade delete is
/// deliberate: only future PENDING occurrences are ever deleted, and a day that has
/// not happened yet cannot have been rated.
///
/// This is evidence, not authority. A run of TOO_EASY never advances a stage on its
/// own — progression reviews stay purely numeric (see domain/progression.ts). All
/// this changes is what the Copilot may suggest and what the app offers to do.
model TaskFeedback {
  id               String         @id @default(cuid())
  taskOccurrenceId String         @unique
  taskOccurrence   TaskOccurrence @relation(fields: [taskOccurrenceId], references: [id], onDelete: Cascade)

  taskDefinitionId String          @map("taskId")
  taskDefinition   TaskDefinition  @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  participantId    String
  participant      GoalParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// The rated day, in the goal's timezone. Copied from the occurrence.
  day String // YYYY-MM-DD

  /// TOO_EASY | JUST_RIGHT | TOO_HARD
  rating String
  /// Optional free text. Shown back to the user; never fed to the model as an
  /// instruction, only as quoted context.
  note   String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskDefinitionId, participantId, day])
  @@index([participantId, day])
}

// ---------------------------------------------------------------- progression
//
// A progression plan makes a task get harder on purpose: walk 15 → 20 → 25 → 30
// minutes. It hangs off an ordinary TaskDefinition rather than replacing it, so a
// progressive goal is still a Phase 1 goal — the same occurrences, the same
// scoring, the same leaderboards.
//
// Two rules shape the whole design:
//  * Advancing is never automatic on poor completion. Every change is a
//    ProgressionDecision with the numbers it was based on, and the backend decides
//    ADVANCE / STAY / REDUCE / ASK_USER — the AI may only ever suggest.
//  * Past days are never rewritten. Stage targets are stamped onto each
//    TaskOccurrence when it is materialised, and only future days are restamped.

model ProgressionPlan {
  id               String         @id @default(cuid())
  taskDefinitionId String         @unique
  taskDefinition   TaskDefinition @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)

  // MINUTES | REPS | DISTANCE_KM | PAGES | AMOUNT | COUNT
  metricType String
  /// Display-only suffix, e.g. "min", "pages", "km". Never parsed.
  unitLabel  String @default("")

  /// 0-based. The "2" in "Stage 2 of 4" is currentStageIndex + 1.
  currentStageIndex Int @default(0)

  /// Completion rate (0-100) over the review window required before ADVANCE.
  advanceThreshold Int @default(80)
  /// Below this the plan proposes REDUCE rather than STAY.
  reduceThreshold  Int @default(40)

  /// Day the current stage started, in the goal's timezone. The review window
  /// starts here, so a stage that has just changed cannot immediately advance
  /// again on last week's numbers.
  stageStartedOn String // YYYY-MM-DD
  lastReviewedOn String? // YYYY-MM-DD

  status String @default("ACTIVE") // ACTIVE | COMPLETED | ABANDONED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages    ProgressionStage[]
  decisions ProgressionDecision[]
}

model ProgressionStage {
  id     String          @id @default(cuid())
  planId String
  plan   ProgressionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// 0-based and contiguous; the application enforces no gaps.
  stageIndex Int
  /// The number being progressed: 15, 20, 25, 30.
  target     Int
  /// Optional override for the task title while this stage is current.
  label      String @default("")
  /// Minimum days to hold this stage before it is eligible to advance.
  minDays    Int    @default(7)

  @@unique([planId, stageIndex])
}

/// The audit trail. One row per evaluation, applied or not, so a stage change can
/// always be explained with the numbers that produced it.
model ProgressionDecision {
  id     String          @id @default(cuid())
  planId String
  plan   ProgressionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  action         String // ADVANCE | STAY | REDUCE | ASK_USER
  fromStageIndex Int
  toStageIndex   Int

  // The evidence, frozen at decision time.
  windowStart    String // YYYY-MM-DD
  windowEnd      String // YYYY-MM-DD
  completedCount Int
  eligibleCount  Int
  completionRate Int // 0-100

  /// SYSTEM (a scheduled review) | USER (they chose) | COPILOT (a suggestion).
  /// A COPILOT row is never applied without a matching USER row.
  source String @default("SYSTEM")
  reason String @default("")

  /// Null until the decision actually moved currentStageIndex. An unapplied row
  /// is a proposal, which is how ASK_USER stays a question rather than a change.
  appliedAt DateTime?

  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

// ---------------------------------------------------------------- social

// One row per pair, with userAId < userBId enforced by the application so that a
// duplicate friendship is impossible.
model Friendship {
  id      String @id @default(cuid())
  userAId String
  userA   User   @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User   @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  status String // PENDING | ACCEPTED | BLOCKED

  requestedById String
  requestedBy   User    @relation("FriendshipRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  // Set when status is BLOCKED, so the block can be undone by its author only.
  blockedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userBId])
}

model GoalInvitation {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User   @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  status String @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([goalId, inviteeId])
  @@index([inviteeId, status])
}

// ---------------------------------------------------------------- engagement

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // REMINDER | FRIEND | PROGRESS | LEADERBOARD | ACHIEVEMENT
  //   | MORNING_SUMMARY | EVENING_INCOMPLETE
  type  String
  title String
  body  String @default("")
  // JSON-encoded payload for deep-linking, e.g. { "goalId": "..." }
  data  String @default("{}")

  /// The calendar day this is *about*, in the recipient's own timezone. Set for the
  /// scheduled daily notifications and null for event-driven ones, which are about a
  /// moment rather than a day.
  localDate String?

  /// "userId:TYPE:localDate" for anything that must arrive at most once a day.
  ///
  /// Unique so the database is what enforces it. A job that runs twice — a retry, an
  /// overlapping worker, a server restart mid-batch — is normal, and a check-then-write
  /// in application code races. Null for event-driven notifications: PostgreSQL treats
  /// NULLs as distinct in a unique index, so any number of them coexist, which is
  /// exactly right here (and the opposite of what UserPreference.category needs).
  dedupeKey String? @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique // FIRST_TASK, STREAK_7, TASKS_30, ...
  title       String
  description String
  icon        String @default("🏆")
  reward      Int    @default(0)

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
}

model RewardTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int // positive = earned, negative = reverted (undo)
  reason String // TASK_COMPLETED | TASK_UNDONE | ACHIEVEMENT | GOAL_COMPLETED

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // One reward row per occurrence, so undo can reverse it exactly once.
  taskOccurrenceId String?         @unique
  taskOccurrence   TaskOccurrence? @relation(fields: [taskOccurrenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ============================================================================
// Phase 2 — Goal Copilot
//
// The AI never writes to Goal/TaskDefinition directly. It produces a GoalDraft,
// the backend validates it, the user confirms, and only then do the existing
// Phase 1 services create the real entities.
// ============================================================================

model CopilotSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // INTERVIEWING | READY_TO_GENERATE | DRAFT_GENERATED | CONFIRMED | CANCELLED | EXPIRED
  status String @default("INTERVIEWING")

  initialGoalText String
  category        String?

  /// The authoritative structured context, JSON-encoded. Goal generation reads
  /// THIS, not the raw transcript, so a user correction genuinely overwrites an
  /// earlier answer instead of both versions lingering in the chat history.
  structuredContext String @default("{}")
  summary           String @default("")

  /// Question ids already asked, so the model cannot repeat itself.
  askedQuestionIds String @default("[]")
  questionCount    Int    @default(0)

  /// Bumped on every applied interview turn. A generate request carries the
  /// revision it last saw; a mismatch means the interview moved on since the
  /// plan was requested, and the request is rejected as stale instead of
  /// building a plan from a picture that no longer exists.
  revision Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  messages CopilotMessage[]
  drafts   GoalDraft[]

  @@index([userId, status])
}

model CopilotMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    String // system | user | assistant
  content String

  /// JSON-encoded question or extracted context that went with this turn.
  structuredPayload String?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model GoalDraft {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String?
  session   CopilotSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  title       String
  description String  @default("")
  category    String
  targetType  String
  targetValue Int?
  deadline    String? // YYYY-MM-DD
  visibility  String  @default("PRIVATE")

  /// Why this plan fits this user — shown on the review screen.
  rationale String @default("")

  // GENERATED | EDITING | CONFIRMED | DISCARDED
  status String @default("GENERATED")

  /// Set once the user confirms and the real Goal is created.
  createdGoalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks GoalDraftTask[]

  @@index([userId, status])
}

model GoalDraftTask {
  id      String    @id @default(cuid())
  draftId String
  draft   GoalDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  title       String
  description String @default("")

  recurrenceType   String
  recurrenceConfig String @default("{}")

  estimatedMinutes Int?
  preferredTime    String? // HH:MM

  /// A proposed build-up ladder, as JSON: { metricType, unitLabel, stages[] }.
  /// Null for the ordinary case. Stored on the draft rather than as rows because a
  /// draft is a proposal — the real ProgressionPlan is created from this on
  /// confirmation, through the same service manual creation uses.
  progressionConfig String?

  /// The personalised justification, quoted back to the user on review.
  reason    String @default("")
  sortOrder Int    @default(0)

  @@index([draftId, sortOrder])
}

model UserPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// GLOBAL | CATEGORY | GOAL
  scope    String @default("GLOBAL")
  /// Empty string for GLOBAL scope. NOT nullable: a NULL is never equal to another
  /// NULL in a unique index — true on PostgreSQL as it was on SQLite — so nullable
  /// here would let duplicate global preferences pile up unnoticed.
  category String @default("")

  key   String
  value String

  confidence Float  @default(0.5)
  source     String @default("COPILOT") // COPILOT | USER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope, category, key])
  @@index([userId])
}

/// Provider call telemetry. Never stores prompts, completions or secrets.
model AiCallLog {
  id     String  @id @default(cuid())
  userId String?

  provider      String
  model         String
  promptVersion String
  purpose       String // INTERVIEW | DRAFT_GENERATION | DRAFT_EDIT | PROGRESS_ANALYSIS | PREFERENCE_EXTRACTION

  /// Time inside the provider call itself.
  latencyMs        Int
  /// Wall time for the whole logical call, including schema-repair retries.
  totalMs          Int?
  promptTokens     Int?
  completionTokens Int?

  status     String // OK | INVALID_JSON | PROVIDER_ERROR | TIMEOUT
  errorType  String?
  retryCount Int     @default(0)

  sessionId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Product analytics for the Copilot funnel.
model CopilotEvent {
  id     String  @id @default(cuid())
  userId String?

  type      String // SESSION_STARTED | QUESTION_ANSWERED | DRAFT_GENERATED | ...
  sessionId String?
  draftId   String?
  meta      String  @default("{}")

  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

/// Append-only recommendation history (Stage 2). One row per durable fact about
/// one recommended entity. Rows are never updated or deleted except by account
/// deletion; corrections are new rows that supersede earlier ones by order.
model RecommendationEvent {
  id String @id @default(cuid())

  /// Ownership is server-derived; this relation is what account deletion walks.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Context only. SetNull, following GoalDraft.session: deleting a goal must
  /// not erase user-level memory of what was recommended, saved or consumed.
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  /// Domain-open entity fields, verbatim from the validated Stage 1 schema.
  entityType  String
  displayName String
  attribution String?

  /// casefold(displayName) + '|' + casefold(attribution ?? '') — computed
  /// server-side by the Stage 1 helper, never accepted from a client, so
  /// folding never reparses presentation text.
  identityKey String

  /// Registered kind (closed set in domain/recommendation-events.ts):
  /// recommended | shown | saved | unsaved | consumed | consumption_corrected |
  /// excluded | exclusion_removed | liked | disliked | preference_corrected.
  /// Arbitrary strings from any model or client are rejected at write time.
  /// `shown` is defined but never written in Stage 2 — the server cannot prove
  /// the client rendered the cards.
  eventKind String

  /// Version of the payload shape and of the event semantics.
  schemaVersion Int @default(1)

  /// Deterministic idempotency key, server-derived (never client-supplied).
  /// Uniqueness is the database guarantee that a replay writes nothing.
  requestId String

  /// Versioned JSON: { schemaVersion: 1, reason?, note? }. Always data — never
  /// secrets, never executable content.
  payload String @default("{}")

  occurredAt DateTime @default(now())

  /// Global monotonic write order — the fold's tiebreaker. OccurredAt alone is
  /// not unique under concurrency.
  seq Int @unique @default(autoincrement())

  /// Informational pointer to the event a correction supersedes, when known at
  /// write time. The fold relies on (seq) order, never on this pointer.
  supersedesEventId String?

  createdAt DateTime @default(now())

  @@unique([userId, requestId])
  @@index([userId, identityKey])
  @@index([userId, seq])
  @@index([goalId])
}

/// Capability execution audit + idempotency record (Stage 4). ONE row per
/// logical operation (userId, capability, operationId). The row is created as
/// PENDING inside the same transaction as the business mutation — the unique
/// index is the concurrency arbiter — and is finalized to SUCCEEDED on
/// success. FAILED rows are written post-rollback for audit and are
/// re-claimable (retry after a failed transaction re-executes).
model CapabilityExecution {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability    String
  operationId   String
  inputDigest   String
  state         String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  targetRefs    String   @default("[]") // JSON EntityRef[] — ids and kinds only
  confirmation  String   @default("none") // none | confirm | confirm_destructive
  errorCode     String?
  resultSummary String   @default("{}") // JSON safe result summary — never prompts/raw payloads
  latencyMs     Int      @default(0)
  replayCount   Int      @default(0)
  correlationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, capability, operationId])
  @@index([userId, capability, createdAt])
  @@index([createdAt])
}
